@{
    ViewData["Title"] = "Yeni Yaptırım Kaydı";
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-md-10">
        
        <div class="d-flex align-items-center mb-4">
            <a href="@Url.Action("Index", "Sanction")" class="btn btn-sm btn-outline-secondary me-3" style="border: none; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--bg-card); box-shadow: var(--shadow-sm);">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h3 class="fw-bolder mb-0 text-gradient">Yeni Yaptırım Kaydı</h3>
                <p class="text-secondary mb-0">Veritabanına manuel bir kişi veya kurum ekleyin.</p>
            </div>
        </div>

        <div class="custom-card">
            <form id="create-sanction-form">
                
                <div class="row g-5">
                    <!-- Sol Kolon: Temel Bilgiler -->
                    <div class="col-md-6">
                        <h5 class="fw-bold mb-4 pb-2 border-bottom text-primary-dark">Kimlik Bilgileri</h5>
                        
                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">Ad Soyad / Unvan</label>
                            <input type="text" class="form-control dark-input" id="FullName" required placeholder="Örn: John Doe veya Apple Inc.">
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">Varlık Türü</label>
                            <select class="form-select dark-input" id="EntityType" required>
                                <option value="1">Kişi (Individual)</option>
                                <option value="2">Kurum (Organization)</option>
                            </select>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">Doğum / Kuruluş Tarihi</label>
                            <input type="date" class="form-control dark-input" id="DateOfBirth">
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">Ülke (ISO-2)</label>
                            <input type="text" class="form-control dark-input" id="Country" maxlength="2" placeholder="Örn: US, TR, GB">
                        </div>
                    </div>

                    <!-- Sağ Kolon: Yaptırım Detayları -->
                    <div class="col-md-6">
                        <h5 class="fw-bold mb-4 pb-2 border-bottom text-primary-dark">Yaptırım & Risk Profili</h5>
                        
                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">Liste Kaynağı (List Source)</label>
                            <input type="text" class="form-control dark-input" id="ListSource" required placeholder="Örn: OFAC, UN, EU">
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">Özel Kimlik / Pasaport No</label>
                            <input type="text" class="form-control dark-input" id="NationalId" placeholder="Opsiyonel">
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">Risk Seviyesi</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="RiskLevel" id="risk1" value="1" checked>
                                    <label class="form-check-label badge risk-low" for="risk1">Düşük</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="RiskLevel" id="risk2" value="2">
                                    <label class="form-check-label badge risk-medium" for="risk2">Orta</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="RiskLevel" id="risk3" value="3">
                                    <label class="form-check-label badge risk-high" for="risk3">Yüksek</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">Sistem Durumu</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="IsActive" checked style="transform: scale(1.3); margin-left: -2.5em;">
                                <label class="form-check-label ms-3 fw-semibold" for="IsActive">Kayıt Aktif Edilsin (Taramalara Dahil Olacak)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-4 mt-2 d-flex justify-content-end gap-3" style="border-color: var(--border-color) !important;">
                    <a href="@Url.Action("Index", "Sanction")" class="btn bg-white px-4 fw-semibold" style="border: 1px solid var(--border-color); color: var(--text-secondary); transition: all 0.2s; border-radius: 12px;">İptal Et</a>
                    <button type="submit" class="btn btn-neon px-5" id="btn-save">
                        <i class="fa-solid fa-check me-2"></i> Kaydı Tamamla
                    </button>
                </div>
                
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#create-sanction-form').on('submit', function(e) {
                e.preventDefault();
                
                const $btn = $('#btn-save');
                const originalText = $btn.html();
                $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-2"></i> Kaydediliyor...');

                const data = {
                    fullName: $('#FullName').val().trim(),
                    entityType: parseInt($('#EntityType').val()),
                    country: $('#Country').val().trim(),
                    listSource: $('#ListSource').val().trim(),
                    nationalId: $('#NationalId').val().trim(),
                    dateOfBirth: $('#DateOfBirth').val() || null,
                    isActive: $('#IsActive').is(':checked'),
                    riskLevel: parseInt($('input[name="RiskLevel"]:checked').val() || "2")
                };

                // Ajax call to Sanction API (Placeholder URL - gerçek URL Sanction endpointidir)
                $.ajax({
                    url: `${API_BASE_URL}/sanctions`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        toastr.success('Kayıt başarıyla oluşturuldu.', 'Başarılı');
                        setTimeout(() => {
                            window.location.href = '@Url.Action("Index", "Sanction")';
                        }, 1500);
                    },
                    error: function(xhr) {
                        $btn.prop('disabled', false).html(originalText);
                        toastr.error('Kayıt oluşturulurken bir hata meydana geldi.', 'Hata');
                    }
                });
            });
        });
    </script>
}
