@{
    ViewData["Title"] = "Yaptırım Listesi Yönetimi";
}

<div class="row">
    <div class="col-12">
        <div class="row mb-5">
            <div class="col-12">
                <div class="glass-banner d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="fw-bolder mb-2 text-gradient">Yeni Yaptırım Kaydı Oluştur</h3>
                        <p class="text-secondary mb-0" style="font-size: 0.95rem;">Küresel veritabanına yeni bir kişi veya kurum eklemek için detay sayfasına geçiş yapın.</p>
                    </div>
                    <div>
                        <a href="@Url.Action("Create", "Sanction")" class="btn btn-neon d-flex align-items-center gap-2">
                            <i class="fa-solid fa-plus"></i> Kayıt Formunu Aç
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="custom-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bolder mb-0 text-primary-dark">Aktif Yaptırım Listesi</h5>
            </div>
            
            <div class="table-responsive">
                <table class="table dark-table w-100" id="sanctionTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>İsim / Unvan</th>
                            <th>Tip</th>
                            <th>Ülke</th>
                            <th>Kaynak</th>
                            <th>Doğum/Kuruluş</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- DataTables will populate this -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        let dataTable;

        $(document).ready(function() {
            initDataTable();
        });

        function initDataTable() {
            dataTable = $('#sanctionTable').DataTable({
                "processing": true,
                "serverSide": false, // Şimdilik tüm datayı çekiyoruz (Pagination API'ye eklenince true yapılır)
                "ajax": {
                    "url": `${API_BASE_URL}/sanctionentries`,
                    "type": "GET",
                    "dataSrc": function (json) {
                        return json.data || json; // ApiResponse data field
                    },
                    "error": function() {
                        toastr.error("Kayıtlar listelenemedi.", "API Hatası");
                    }
                },
                "columns": [
                    { "data": "id", "width": "5%" },
                    { "data": "fullName", "className": "fw-bold align-middle" },
                    { 
                        "data": "entityType",
                        "className": "align-middle",
                        "render": function(data) {
                            if(data === 1) {
                                return `<div class="d-flex align-items-center gap-2">
                                            <div class="avatar-sm" style="width:28px;height:28px;background:var(--accent-light);color:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i class="fa-solid fa-user" style="font-size:0.75rem;"></i></div>
                                            <span>Kişi</span>
                                        </div>`;
                            } else {
                                return `<div class="d-flex align-items-center gap-2">
                                            <div class="avatar-sm" style="width:28px;height:28px;background:var(--status-medium-bg);color:var(--status-medium);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i class="fa-solid fa-building" style="font-size:0.75rem;"></i></div>
                                            <span>Kurum</span>
                                        </div>`;
                            }
                        }
                    },
                    { "data": "country", "className": "align-middle" },
                    { "data": "listSource", "className": "align-middle" },
                    { 
                        "data": "dateOfBirth",
                        "className": "align-middle",
                        "render": function(data) {
                            if(!data) return '-';
                            return new Date(data).toLocaleDateString();
                        }
                    },
                    { 
                        "data": "isActive",
                        "className": "align-middle",
                        "render": function(data) {
                            return data ? '<span class="badge risk-low">Aktif</span>' : '<span class="badge risk-high">Pasif</span>';
                        }
                    },
                    { 
                        "data": null,
                        "className": "text-end align-middle",
                        "render": function(data, type, row) {
                            return `
                                <div class="table-action-btns">
                                    <button class="btn btn-sm bg-white" style="border: 1px solid var(--border-color); color: var(--text-primary); transition: all 0.2s;" onmouseover="this.style.borderColor='var(--accent)';" onmouseout="this.style.borderColor='var(--border-color)';" onclick="toastr.info('Düzenleme sayfası yakında eklenecek!', 'Hazırlık')" title="Düzenle">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm bg-white text-danger ms-1" style="border: 1px solid var(--border-color); transition: all 0.2s;" onmouseover="this.style.borderColor='var(--status-critical)';" onmouseout="this.style.borderColor='var(--border-color)';" onclick="deleteSanction(${row.id})" title="Sil">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            `;
                        },
                        "orderable": false
                    }
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                }
            });
        }


        function deleteSanction(id) {
            if(confirm("Bu kaydı silmek istediğinize emin misiniz? (Pasif konuma alınacaktır)")) {
                $.ajax({
                    url: `${API_BASE_URL}/sanctionentries/${id}`,
                    type: 'DELETE',
                    success: function() {
                        toastr.success("Kayıt başarıyla pasif duruma getirildi.", "Başarılı");
                        dataTable.ajax.reload(null, false);
                    },
                    error: function() {
                        toastr.error("Silme işlemi başarısız.", "Hata");
                    }
                });
            }
        }
    </script>
}
