@model Guid?
@{
    ViewData["Title"] = "Eşleşme İncelemesi";
    var reviewId = ViewBag.ReviewId;
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-md-11">
        
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center">
                <a href="@Url.Action("Results", "Screening")" class="btn btn-sm btn-outline-secondary me-3" style="border: none; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--bg-card); box-shadow: var(--shadow-sm);">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h3 class="fw-bolder mb-0 text-gradient">Detaylı İnceleme (Review)</h3>
                    <p class="text-secondary mb-0">Eşleşme Detayları - Kayıt ID: <strong class="text-primary-dark">#@reviewId.ToString().Substring(0,8)</strong></p>
                </div>
            </div>
            <div>
                <span class="badge risk-high px-3 py-2" style="font-size: 0.9rem;"><i class="fa-solid fa-bolt me-1"></i> %95 Benzerlik (Fuzzy)</span>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Sol Kolon: Taranan (Sorgulanan) Profil -->
            <div class="col-md-5">
                <div class="custom-card h-100" style="background: rgba(255,255,255,0.4); border: 2px dashed var(--border-color);">
                    <div class="text-center mb-4">
                        <div class="avatar-lg mx-auto mb-3" style="width:72px; height:72px; background:var(--bg-card); color:var(--text-secondary); border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow: var(--shadow-sm); border: 1px solid var(--border-color);">
                            <i class="fa-solid fa-magnifying-glass fa-2x"></i>
                        </div>
                        <h5 class="fw-bold text-primary-dark mb-1">Müşteri / Sorgu Verisi</h5>
                        <p class="text-secondary small">Sistem veya kullanıcı tarafından aratılan bilgi</p>
                    </div>

                    <div class="p-3 rounded-3 mb-3" style="background: var(--bg-card); box-shadow: var(--shadow-sm);">
                        <label class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Aratılan İsim</label>
                        <h5 class="fw-bold mb-0">Johnathan Doe</h5>
                    </div>
                    
                    <div class="p-3 rounded-3" style="background: var(--bg-card); box-shadow: var(--shadow-sm);">
                        <label class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Sorgu Tipi</label>
                        <p class="fw-semibold mb-0">Kişi (Individual)</p>
                    </div>
                </div>
            </div>

            <!-- Orta Ikon -->
            <div class="col-md-2 d-flex flex-column align-items-center justify-content-center">
                <div class="mb-3 p-3 rounded-circle" style="background: var(--accent-light); color: var(--accent); box-shadow: var(--shadow-sm);">
                    <i class="fa-solid fa-code-compare fa-2x"></i>
                </div>
                <span class="badge" style="background: var(--accent-light); color: var(--accent);">Eşleşme Bulundu</span>
            </div>

            <!-- Sağ Kolon: Veritabanı Yaptırım Profili -->
            <div class="col-md-5">
                <div class="custom-card h-100" style="border-left: 4px solid var(--status-critical);">
                    <div class="text-center mb-4">
                        <div class="avatar-lg mx-auto mb-3" style="width:72px; height:72px; background:var(--status-critical-bg); color:var(--status-critical); border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow: var(--shadow-sm);">
                            <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
                        </div>
                        <h5 class="fw-bold text-primary-dark mb-1">Yaptırım Listesi Kaydı</h5>
                        <p class="text-secondary small">OFAC (SDN) Listesindeki gerçek kayıt</p>
                    </div>

                    <div class="p-3 rounded-3 mb-3" style="background: var(--bg-main); border: 1px solid var(--border-color);">
                        <label class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Kayıtlı İsim</label>
                        <h5 class="fw-bold mb-0 text-danger">John Doe (Alias)</h5>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 rounded-3 h-100" style="background: var(--bg-main); border: 1px solid var(--border-color);">
                                <label class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Liste</label>
                                <p class="fw-semibold mb-0">OFAC</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3 h-100" style="background: var(--bg-main); border: 1px solid var(--border-color);">
                                <label class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Risk</label>
                                <p class="fw-semibold mb-0 text-danger">Critical</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Karar Butonları -->
        <div class="custom-card">
            <h5 class="fw-bold mb-4">Aksiyon Al (Karar)</h5>
            <p class="text-secondary mb-4">Bu eşleşmenin bir hata (isim benzerliği) mi yoksa gerçek bir yaptırım ihlali mi olduğuna karar verin.</p>
            
            <div class="d-flex gap-4">
                <button class="btn flex-fill py-3 d-flex flex-column align-items-center justify-content-center" style="background: var(--status-low-bg); border: 1px solid rgba(5, 150, 105, 0.2); color: var(--status-low); border-radius: 16px; transition: all 0.2s;" onmouseover="this.style.background='rgba(5, 150, 105, 0.2)';" onmouseout="this.style.background='var(--status-low-bg)';" onclick="resolveReview('@reviewId', 'FalsePositive')">
                    <i class="fa-solid fa-circle-check fa-2x mb-2"></i>
                    <span class="fw-bold" style="font-size: 1.1rem;">False Positive (İsim Benzerliği)</span>
                    <small style="opacity: 0.8;">İşleme İzin Ver</small>
                </button>
                
                <button class="btn flex-fill py-3 d-flex flex-column align-items-center justify-content-center" style="background: var(--status-critical-bg); border: 1px solid rgba(225, 29, 72, 0.2); color: var(--status-critical); border-radius: 16px; transition: all 0.2s;" onmouseover="this.style.background='rgba(225, 29, 72, 0.2)';" onmouseout="this.style.background='var(--status-critical-bg)';" onclick="resolveReview('@reviewId', 'TrueMatch')">
                    <i class="fa-solid fa-ban fa-2x mb-2"></i>
                    <span class="fw-bold" style="font-size: 1.1rem;">True Match (Gerçek Eşleşme)</span>
                    <small style="opacity: 0.8;">İşlemi Engelle / Raporla</small>
                </button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function resolveReview(id, status) {
            // Placeholder Resolution Logic (API call will be here)
            const statusText = status === 'TrueMatch' ? 'İşlem Engellendi!' : 'False Positive olarak işaretlendi.';
            const type = status === 'TrueMatch' ? 'error' : 'success';
            
            // Animasyonlu kilitlenme
            $('button').prop('disabled', true);
            
            toastr[type](statusText, "Karar Kaydedildi");
            
            setTimeout(() => {
                window.location.href = '@Url.Action("Results", "Screening")';
            }, 1500);
        }
    </script>
}
