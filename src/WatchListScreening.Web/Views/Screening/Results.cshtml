@{
    ViewData["Title"] = "İnceleme Bekleyenler";
}

<div class="row">
    <div class="col-12">
        <div class="custom-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0">Bekleyen Tarama Sonuçları</h5>
                <button class="btn btn-sm btn-outline-light border-glass" onclick="loadPendingResults()">
                    <i class="fa-solid fa-arrows-rotate me-1"></i> Yenile
                </button>
            </div>
            
            <div class="table-responsive">
                <table class="table dark-table align-middle" id="pendingTable">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Eşleşen Kişi/Kurum</th>
                            <th>Kaynak</th>
                            <th>Risk Skoru</th>
                            <th>Risk Seviyesi</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody id="pendingTableBody">
                        <tr>
                            <td colspan="6" class="text-center py-4 text-secondary">
                                <i class="fa-solid fa-circle-notch fa-spin me-2"></i> Yükleniyor...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        // Sayfa yüklendiğinde datayı çek
        $(document).ready(function() {
            loadPendingResults();
        });

        function loadPendingResults() {
            $('#pendingTableBody').html(`<tr><td colspan="6" class="text-center py-4 text-secondary"><i class="fa-solid fa-circle-notch fa-spin me-2"></i> Yükleniyor...</td></tr>`);
            
            $.ajax({
                url: `${API_BASE_URL}/results/pending`,
                type: 'GET',
                success: function (res) {
                    let html = '';
                    const data = (res && res.data) ? res.data : res; // ApiResponse yapısı
                    
                    if(data && data.length > 0) {
                        data.forEach(item => {
                            // Risk Level Badge
                            let riskBadge = '';
                            if (item.riskLevel === 1) riskBadge = '<span class="badge risk-low">Low</span>';
                            else if (item.riskLevel === 2) riskBadge = '<span class="badge risk-medium">Medium</span>';
                            else if (item.riskLevel === 3) riskBadge = '<span class="badge risk-high">High</span>';
                            else if (item.riskLevel === 4) riskBadge = '<span class="badge risk-critical">Critical</span>';
                            
                            // Date format
                            const date = new Date(item.createdAt).toLocaleString();
                            
                            html += `
                                <tr id="row-${item.id}">
                                    <td class="text-secondary align-middle">${date}</td>
                                    <td class="fw-bold align-middle">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-sm" style="width:32px;height:32px;background:var(--accent-light);color:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i class="fa-solid fa-user-secret" style="font-size:0.8rem;"></i></div>
                                            <span>${item.matchedFullName}</span>
                                        </div>
                                    </td>
                                    <td class="align-middle">${item.matchedListSource}</td>
                                    <td class="align-middle" style="color: var(--accent); font-weight:600;">${item.matchScore.toFixed(1)}%</td>
                                    <td class="align-middle">${riskBadge}</td>
                                    <td class="text-end align-middle">
                                        <div class="table-action-btns">
                                            <button class="btn-expandable" onclick="window.location.href='/Screening/Details/' + '${item.id}'">
                                                <span class="btn-text">İncele</span>
                                                <i class="fa-solid fa-arrow-right btn-icon"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            `;
                        });
                    } else {
                        html = `<tr>
                                    <td colspan="6" class="text-center py-5">
                                        <div class="mb-3 d-flex justify-content-center">
                                            <div style="width:80px;height:80px;background:var(--status-low-bg);color:var(--status-low);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                                <i class="fa-solid fa-check fa-3x"></i>
                                            </div>
                                        </div>
                                        <h5 class="text-primary-dark">Tüm İncelemeler Tamamlandı!</h5>
                                        <p class="text-secondary">Şu anda bekleyen herhangi bir riskli işlem bulunmuyor.</p>
                                    </td>
                                </tr>`;
                    }
                    
                    $('#pendingTableBody').html(html);
                },
                error: function() {
                    $('#pendingTableBody').html(`<tr><td colspan="6" class="text-center py-4 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i> Veriler yüklenirken hata oluştu.</td></tr>`);
                    toastr.error("API bağlantı hatası.", "Hata");
                }
            });
        }
        

    </script>
}
